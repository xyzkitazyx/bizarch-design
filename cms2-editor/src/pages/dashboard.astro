---
import EditorLayout from '@/layouts/EditorLayout.astro';
import SiteCard from '@/components/SiteCard.tsx';
import { SITES } from '@/lib/api';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const infoCards = [
  { title: 'エディタ機能', body: 'ブロック挿入、テキスト編集、画像差替、PC/SP切替、保存、公開まで一通り', status: 'READY', tone: 'blue' },
  { title: 'ブロックライブラリ', body: 'ヒーロー、Q&Aカード、業種カード、CTA、比較表、機能リスト等を内蔵', status: 'V1', tone: 'purple' },
  { title: 'API状態', body: 'cms2/api/*.php 未デプロイ時はローカルスタブで動作', status: 'AUTO', tone: 'coral' },
];
---
<EditorLayout title="ダッシュボード | bizarch CMS2">
  <main class="min-h-screen bg-blueprint">
    <header class="bg-white border-b border-gray-100 sticky top-0 z-10 backdrop-blur bg-white/90">
      <div class="max-w-6xl mx-auto px-6 h-14 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-gradient-brand grid place-items-center text-white font-black text-sm">
            B
          </div>
          <div>
            <div class="text-sm font-black"><span class="text-gradient">bizarch</span> CMS2</div>
            <div class="text-[10px] text-gray-400 font-mono">visual editor / day 1</div>
          </div>
        </div>
        <button
          id="logoutBtn"
          class="text-xs text-gray-500 hover:text-gray-900 transition px-3 py-1.5 rounded-md hover:bg-gray-50"
        >
          ログアウト
        </button>
      </div>
    </header>

    <section class="max-w-6xl mx-auto px-6 py-12">
      <div class="mb-8">
        <h1 class="text-3xl font-black text-gray-900 mb-1">
          編集する<span class="text-gradient">サイト</span>を選択
        </h1>
        <p class="text-sm text-gray-500">
          各サイトのページ・セクションをビジュアルに編集できます
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {SITES.map((site) => (
          <SiteCard site={site} baseUrl={baseUrl} client:load />
        ))}
      </div>

      <div class="mt-16 grid md:grid-cols-3 gap-4">
        {infoCards.map((c) => {
          const toneClass =
            c.tone === 'blue' ? 'text-electric-blue bg-electric-blue/10' :
            c.tone === 'purple' ? 'text-deep-purple bg-deep-purple/10' :
            'text-soft-coral bg-soft-coral/10';
          return (
            <div class="rounded-xl border border-gray-100 bg-white p-4">
              <div class="flex items-center justify-between mb-2">
                <h3 class="text-xs font-bold text-gray-700">{c.title}</h3>
                <span class={`text-[10px] font-black px-2 py-0.5 rounded ${toneClass}`}>{c.status}</span>
              </div>
              <p class="text-[11px] text-gray-500 leading-relaxed">{c.body}</p>
            </div>
          );
        })}
      </div>
    </section>
  </main>

  <script>
    const base = (import.meta as any).env?.BASE_URL?.replace(/\/$/, '') ?? '/editor';
    const btn = document.getElementById('logoutBtn');
    btn?.addEventListener('click', async () => {
      if (!confirm('ログアウトしますか？')) return;
      try {
        // 認証API（あれば）をコール後トークン破棄
        await fetch(
          (location.hostname.includes('bizarch-design.com') ? 'https://cms2.bizarch-design.com' : '') + '/api/auth.php',
          {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CMS2-Token': localStorage.getItem('cms2_token') ?? '' },
            body: JSON.stringify({ action: 'logout' }),
          }
        ).catch(() => null);
      } finally {
        localStorage.removeItem('cms2_token');
        window.location.href = base + '/';
      }
    });
    if (!localStorage.getItem('cms2_token')) {
      window.location.href = base + '/';
    }
  </script>
</EditorLayout>
